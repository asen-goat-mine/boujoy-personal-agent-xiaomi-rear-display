{
  "package": {
    "edition": "2021",
    "rust-version": "1.82",
    "name": "windows-core",
    "version": "0.62.2",
    "build": false,
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Core type support for COM and Windows",
    "readme": "readme.md",
    "categories": [
      "os::windows-apis"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/microsoft/windows-rs",
    "metadata": {
      "docs": {
        "rs": {
          "default-target": "x86_64-pc-windows-msvc",
          "targets": []
        }
      }
    }
  },
  "features": {
    "default": [
      "std"
    ],
    "std": [
      "windows-result/std",
      "windows-strings/std"
    ]
  },
  "lib": {
    "name": "windows_core",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "windows-implement": {
      "version": "0.60.2",
      "default-features": false
    },
    "windows-interface": {
      "version": "0.59.3",
      "default-features": false
    },
    "windows-link": {
      "version": "0.2.1",
      "default-features": false
    },
    "windows-result": {
      "version": "0.4.1",
      "default-features": false
    },
    "windows-strings": {
      "version": "0.5.1",
      "default-features": false
    }
  },
  "lints": {
    "rust": {
      "missing_unsafe_on_extern": "warn",
      "unexpected_cfgs": {
        "level": "warn",
        "priority": 0,
        "check-cfg": [
          "cfg(windows_raw_dylib, windows_slim_errors)"
        ]
      }
    }
  }
}
