{
  "package": {
    "edition": "2018",
    "rust-version": "1.78.0",
    "name": "system-deps",
    "version": "9.0.0",
    "authors": [
      "Guillaume Desmottes <guillaume.desmottes@collabora.com>",
      "Josh Triplett <josh@joshtriplett.org>"
    ],
    "build": "build.rs",
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Discover and configure system dependencies from declarative dependencies in Cargo.toml",
    "documentation": "https://docs.rs/system-deps/",
    "readme": "README.md",
    "keywords": [
      "pkg-config",
      "build-dependencies",
      "build-depends",
      "manifest",
      "metadata"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/gdesmott/system-deps"
  },
  "features": {
    "binary": [
      "system-deps-meta/binary",
      "dep:which",
      "toml/serde"
    ],
    "default": [],
    "gz": [
      "system-deps-meta/gz"
    ],
    "inno": [
      "system-deps-meta/inno"
    ],
    "pkg": [
      "system-deps-meta/pkg"
    ],
    "xz": [
      "system-deps-meta/xz"
    ],
    "zip": [
      "system-deps-meta/zip"
    ]
  },
  "lib": {
    "name": "system_deps",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "cfg-expr": {
      "version": ">= 0.17, < 0.21",
      "features": [
        "targets"
      ]
    },
    "heck": {
      "version": "0.5"
    },
    "pkg-config": {
      "version": "0.3.34"
    },
    "system-deps-meta": {
      "version": "9.0.0",
      "optional": true
    },
    "toml": {
      "version": "1",
      "features": [
        "parse",
        "std"
      ],
      "default-features": false
    },
    "version-compare": {
      "version": "0.2"
    },
    "which": {
      "version": "8",
      "optional": true
    }
  },
  "dev-dependencies": {
    "assert_matches": {
      "version": "1.5"
    },
    "itertools": {
      "version": "0.14"
    },
    "system-deps-meta": {
      "version": "9.0.0",
      "features": [
        "test"
      ]
    },
    "tiny_http": {
      "version": "0.12"
    }
  },
  "build-dependencies": {
    "system-deps-meta": {
      "version": "9.0.0",
      "optional": true
    }
  }
}
