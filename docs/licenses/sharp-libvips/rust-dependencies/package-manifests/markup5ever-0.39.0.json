{
  "package": {
    "edition": "2021",
    "rust-version": "1.71.0",
    "name": "markup5ever",
    "version": "0.39.0",
    "authors": [
      "The html5ever Project Developers"
    ],
    "build": false,
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Common code for xml5ever and html5ever",
    "documentation": "https://docs.rs/markup5ever",
    "readme": false,
    "categories": [
      "parser-implementations",
      "web-programming"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/servo/html5ever"
  },
  "features": {
    "serde": [
      "web_atoms/serde"
    ]
  },
  "lib": {
    "name": "markup5ever",
    "path": "lib.rs"
  },
  "dependencies": {
    "log": {
      "version": "0.4"
    },
    "tendril": {
      "version": "0.5"
    },
    "web_atoms": {
      "version": "0.2.3"
    }
  }
