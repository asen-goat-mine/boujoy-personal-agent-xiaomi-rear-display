{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "gio-win32",
    "version": "0.22.8",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": false,
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Rust bindings for the GioWin32 library",
    "homepage": "https://gtk-rs.org/",
    "documentation": "https://gtk-rs.org/gtk-rs-core/stable/latest/docs/gio-win32/",
    "readme": "README.md",
    "keywords": [
      "gio",
      "gtk-rs",
      "gnome",
      "GUI"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--generate-link-to-definition"
          ]
        }
      }
    }
  },
  "features": {
    "default": [],
    "v2_58": [
      "gio-win32-sys/v2_82",
      "gio/v2_58"
    ],
    "v2_60": [
      "v2_58",
      "gio-win32-sys/v2_60",
      "gio/v2_60"
    ],
    "v2_66": [
      "v2_60",
      "gio-win32-sys/v2_66",
      "gio/v2_66"
    ],
    "v2_78": [
      "v2_60",
      "gio-win32-sys/v2_78",
      "gio/v2_78"
    ],
    "v2_82": [
      "v2_78",
      "gio-win32-sys/v2_82",
      "gio/v2_82"
    ],
    "v2_84": [
      "v2_82",
      "gio-win32-sys/v2_84",
      "gio/v2_84"
    ]
  },
  "lib": {
    "name": "gio_win32",
    "path": "src/lib.rs"
  },
  "test": [
    {
      "name": "check_gir",
      "path": "tests/check_gir.rs"
    }
  ],
  "dependencies": {
    "gio": {
      "version": "0.22.0"
    },
    "gio-win32-sys": {
      "version": "0.22.0"
    },
    "glib": {
      "version": "0.22.0",
      "default-features": false
    }
  },
  "dev-dependencies": {
    "gir-format-check": {
      "version": "^0.1"
    }
  }
}
