{
  "package": {
    "edition": "2021",
    "rust-version": "1.71.0",
    "name": "tendril",
    "version": "0.5.1",
    "authors": [
      "Keegan McAllister <mcallister.keegan@gmail.com>",
      "Simon Sapin <simon.sapin@exyr.org>",
      "Chris Morgan <me@chrismorgan.info>"
    ],
    "build": false,
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Compact buffer/string type for zero-copy parsing",
    "readme": "README.md",
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/servo/html5ever"
  },
  "features": {
    "encoding_rs": [
      "dep:encoding_rs"
    ]
  },
  "lib": {
    "name": "tendril",
    "path": "src/lib.rs"
  },
  "example": [
    {
      "name": "fuzz",
      "path": "examples/fuzz.rs"
    }
  ],
  "bench": [
    {
      "name": "futf",
      "path": "benches/futf.rs",
      "harness": false
    },
    {
      "name": "tendril",
      "path": "benches/tendril.rs",
      "harness": false
    }
  ],
  "dependencies": {
    "encoding_rs": {
      "version": "0.8.12",
      "optional": true
    },
    "new_debug_unreachable": {
      "version": "1.0.2"
    }
  },
  "dev-dependencies": {
    "criterion": {
      "version": "0.8"
    },
    "rand": {
      "version": "0.9"
    }
  }
}
