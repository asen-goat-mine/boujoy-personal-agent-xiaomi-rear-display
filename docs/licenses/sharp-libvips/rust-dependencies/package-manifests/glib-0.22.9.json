{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "glib",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": false,
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Rust bindings for the GLib library",
    "homepage": "https://gtk-rs.org/",
    "documentation": "https://gtk-rs.org/gtk-rs-core/stable/latest/docs/glib/",
    "readme": "README.md",
    "keywords": [
      "glib",
      "gtk-rs",
      "gnome",
      "GUI"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--generate-link-to-definition"
          ]
        }
      }
    }
  },
  "features": {
    "compiletests": [],
    "default": [
      "gio",
      "futures"
    ],
    "futures": [
      "futures-core",
      "futures-task",
      "futures-executor",
      "futures-channel",
      "futures-util"
    ],
    "gio": [
      "gio-sys",
      "futures"
    ],
    "log": [
      "rs-log"
    ],
    "log_kv": [
      "log",
      "rs-log/kv"
    ],
    "log_macros": [
      "log"
    ],
    "v2_58": [
      "glib-sys/v2_58",
      "gobject-sys/v2_58"
    ],
    "v2_60": [
      "v2_58",
      "glib-sys/v2_60"
    ],
    "v2_62": [
      "v2_60",
      "glib-sys/v2_62",
      "gobject-sys/v2_62"
    ],
    "v2_64": [
      "v2_62",
      "glib-sys/v2_64"
    ],
    "v2_66": [
      "v2_64",
      "glib-sys/v2_66",
      "gobject-sys/v2_66"
    ],
    "v2_68": [
      "v2_66",
      "glib-sys/v2_68",
      "gobject-sys/v2_68"
    ],
    "v2_70": [
      "v2_68",
      "glib-sys/v2_70",
      "gobject-sys/v2_70"
    ],
    "v2_72": [
      "v2_70",
      "glib-sys/v2_72",
      "gobject-sys/v2_72"
    ],
    "v2_74": [
      "v2_72",
      "glib-sys/v2_74",
      "gobject-sys/v2_74"
    ],
    "v2_76": [
      "v2_74",
      "glib-sys/v2_76",
      "gobject-sys/v2_76"
    ],
    "v2_78": [
      "v2_76",
      "glib-sys/v2_78",
      "gobject-sys/v2_78"
    ],
    "v2_80": [
      "v2_78",
      "glib-sys/v2_80",
      "gobject-sys/v2_80"
    ],
    "v2_82": [
      "v2_80",
      "glib-sys/v2_82",
      "gobject-sys/v2_82"
    ],
    "v2_84": [
      "v2_82",
      "glib-sys/v2_84",
      "gobject-sys/v2_84"
    ],
    "v2_86": [
      "v2_84",
      "glib-sys/v2_86",
      "gobject-sys/v2_86"
    ],
    "v2_88": [
      "v2_86",
      "glib-sys/v2_88"
    ],
    "v2_90": [
      "v2_88",
      "glib-sys/v2_90"
    ]
  },
  "lib": {
    "name": "glib",
    "path": "src/lib.rs"
  },
  "test": [
    {
      "name": "bridged_logging",
      "path": "tests/bridged_logging.rs"
    },
    {
      "name": "check_gir",
      "path": "tests/check_gir.rs"
    },
    {
      "name": "clone",
      "path": "tests/clone.rs"
    },
    {
      "name": "derive",
      "path": "tests/derive.rs"
    },
    {
      "name": "log",
      "path": "tests/log.rs"
    },
    {
      "name": "print",
      "path": "tests/print.rs"
    },
    {
      "name": "regex_compiletest",
      "path": "tests/regex_compiletest.rs",
      "required-features": [
        "compiletests"
      ]
    },
    {
      "name": "structured_log",
      "path": "tests/structured_log.rs"
    },
    {
      "name": "subclass_compiletest",
      "path": "tests/subclass_compiletest.rs",
      "required-features": [
        "compiletests"
      ]
    },
    {
      "name": "unicollate",
      "path": "tests/unicollate.rs"
    },
    {
      "name": "value",
      "path": "tests/value.rs"
    }
  ],
  "bench": [
    {
      "name": "gstring",
      "path": "benches/gstring.rs",
      "harness": false
    }
  ],
  "dependencies": {
    "bitflags": {
      "version": "2.10"
    },
    "futures-channel": {
      "version": "0.3",
      "optional": true
    },
    "futures-core": {
      "version": "0.3",
      "optional": true,
      "default-features": false
    },
    "futures-executor": {
      "version": "0.3",
      "optional": true
    },
    "futures-task": {
      "version": "0.3",
      "optional": true,
      "default-features": false
    },
    "futures-util": {
      "version": "0.3",
      "optional": true
    },
    "gio-sys": {
      "version": "0.22.0",
      "optional": true
    },
    "glib-macros": {
      "version": "0.22.0",
      "default-features": false
    },
    "glib-sys": {
      "version": "0.22.0"
    },
    "gobject-sys": {
      "version": "0.22.0"
    },
    "libc": {
      "version": "0.2"
    },
    "memchr": {
      "version": "2.8.0"
    },
    "rs-log": {
      "version": "0.4",
      "optional": true,
      "package": "log"
    },
    "smallvec": {
      "version": "1.15",
      "features": [
        "union",
        "const_generics",
        "const_new"
      ]
    }
  },
  "dev-dependencies": {
    "criterion": {
      "version": "0.8.2"
    },
    "gir-format-check": {
      "version": "^0.1"
    },
    "tempfile": {
      "version": "3"
    },
    "trybuild": {
      "version": "1"
    }
  }
}
