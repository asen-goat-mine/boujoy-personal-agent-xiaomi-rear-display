{
  "package": {
    "edition": "2018",
    "rust-version": "1.63",
    "name": "fastrand",
    "version": "2.5.0",
    "authors": [
      "Stjepan Glavina <stjepang@gmail.com>"
    ],
    "build": false,
    "exclude": [
      "/.*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "A simple and fast random number generator",
    "readme": "README.md",
    "keywords": [
      "simple",
      "fast",
      "rand",
      "random",
      "wyrand"
    ],
    "categories": [
      "algorithms"
    ],
    "license": "Apache-2.0 OR MIT",
    "repository": "https://github.com/smol-rs/fastrand",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--cfg",
            "docsrs"
          ]
        }
      }
    }
  },
  "features": {
    "alloc": [],
    "default": [
      "std"
    ],
    "js": [
      "std",
      "getrandom"
    ],
    "std": [
      "alloc"
    ]
  },
  "lib": {
    "name": "fastrand",
    "path": "src/lib.rs"
  },
  "test": [
    {
      "name": "char",
      "path": "tests/char.rs"
    },
    {
      "name": "smoke",
      "path": "tests/smoke.rs"
    }
  ],
  "bench": [
    {
      "name": "bench",
      "path": "benches/bench.rs"
    }
  ],
  "dev-dependencies": {
    "getrandom": {
      "version": "0.4"
    },
    "rand": {
      "version": "0.10"
    },
    "wyhash": {
      "version": "0.6"
    }
  },
  "target": {
    "cfg(all(any(target_arch = \"wasm32\", target_arch = \"wasm64\"), target_os = \"unknown\"))": {
      "dependencies": {
        "getrandom": {
          "version": "0.4",
          "features": [
            "wasm_js"
          ],
          "optional": true
        }
      },
      "dev-dependencies": {
        "getrandom": {
          "version": "0.4",
          "features": [
            "wasm_js"
          ]
        },
        "wasm-bindgen-test": {
          "version": "0.3"
        }
      }
    }
  }
}
