{
  "package": {
    "name": "approx",
    "version": "0.5.1",
    "authors": [
      "Brendan Zabarauskas <bjzaba@yahoo.com.au>"
    ],
    "description": "Approximate floating point equality comparisons and assertions.",
    "homepage": "https://github.com/brendanzab/approx",
    "documentation": "https://docs.rs/approx",
    "readme": "README.md",
    "keywords": [
      "approximate",
      "assert",
      "comparison",
      "equality",
      "float"
    ],
    "license": "Apache-2.0",
    "repository": "https://github.com/brendanzab/approx",
    "metadata": {
      "docs": {
        "rs": {
          "features": [
            "std",
            "num-complex"
          ]
        }
      }
    }
  },
  "lib": {
    "name": "approx"
  },
  "dependencies": {
    "num-complex": {
      "version": "0.4.0",
      "optional": true
    },
    "num-traits": {
      "version": "0.2.0",
      "default_features": false
    }
  },
  "features": {
    "default": [
      "std"
    ],
    "std": []
  }
}
