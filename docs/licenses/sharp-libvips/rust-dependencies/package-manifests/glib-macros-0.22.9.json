{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "glib-macros",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": false,
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Rust bindings for the GLib library, proc macros crate",
    "homepage": "https://gtk-rs.org/",
    "documentation": "https://gtk-rs.org/gtk-rs-core/stable/latest/docs/glib_macros/",
    "readme": false,
    "keywords": [
      "glib",
      "gtk-rs",
      "gnome",
      "GUI"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core"
  },
  "features": {
    "default": [
      "proc_macro_crate"
    ],
    "proc_macro_crate": [
      "proc-macro-crate"
    ]
  },
  "lib": {
    "name": "glib_macros",
    "path": "src/lib.rs",
    "proc-macro": true
  },
  "test": [
    {
      "name": "clone",
      "path": "tests/clone.rs"
    },
    {
      "name": "closure",
      "path": "tests/closure.rs"
    },
    {
      "name": "enum_dynamic",
      "path": "tests/enum_dynamic.rs"
    },
    {
      "name": "flags_dynamic",
      "path": "tests/flags_dynamic.rs"
    },
    {
      "name": "object_subclass_dynamic",
      "path": "tests/object_subclass_dynamic.rs"
    },
    {
      "name": "properties",
      "path": "tests/properties.rs"
    },
    {
      "name": "test",
      "path": "tests/test.rs"
    },
    {
      "name": "value_delegate_derive",
      "path": "tests/value_delegate_derive.rs"
    }
  ],
  "dependencies": {
    "heck": {
      "version": "0.5"
    },
    "proc-macro-crate": {
      "version": "3.5",
      "optional": true
    },
    "proc-macro2": {
      "version": "1.0"
    },
    "quote": {
      "version": "1.0"
    },
    "syn": {
      "version": "3.0",
      "features": [
        "full"
      ]
    }
  },
  "dev-dependencies": {
    "glib": {
      "version": "0.22.0",
      "default-features": false
    },
    "trybuild": {
      "version": "1"
    }
  }
}
