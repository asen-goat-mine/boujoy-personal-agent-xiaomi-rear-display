{
  "package": {
    "edition": "2018",
    "rust-version": "1.60.0",
    "name": "ahash",
    "version": "0.8.12",
    "authors": [
      "Tom Kaitchuck <Tom.Kaitchuck@gmail.com>"
    ],
    "build": "build.rs",
    "exclude": [
      "/smhasher",
      "/benchmark_tools"
    ],
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "A non-cryptographic hash function using AES-NI for high performance",
    "documentation": "https://docs.rs/ahash",
    "readme": "README.md",
    "keywords": [
      "hash",
      "hasher",
      "hashmap",
      "aes",
      "no-std"
    ],
    "categories": [
      "algorithms",
      "data-structures",
      "no-std"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/tkaitchuck/ahash",
    "metadata": {
      "docs": {
        "rs": {
          "features": [
            "std"
          ],
          "rustc-args": [
            "-C",
            "target-feature=+aes"
          ],
          "rustdoc-args": [
            "-C",
            "target-feature=+aes"
          ]
        }
      }
    }
  },
  "profile": {
    "bench": {
      "opt-level": 3,
      "lto": "fat",
      "codegen-units": 1,
      "debug": 0,
      "debug-assertions": false
    },
    "release": {
      "opt-level": 3,
      "lto": "fat",
      "codegen-units": 1,
      "debug": 0,
      "debug-assertions": false
    },
    "test": {
      "opt-level": 2,
      "lto": "fat"
    }
  },
  "lib": {
    "name": "ahash",
    "path": "src/lib.rs",
    "test": true,
    "doctest": true,
    "bench": true,
    "doc": true
  },
  "test": [
    {
      "name": "bench",
      "path": "tests/bench.rs"
    },
    {
      "name": "map_tests",
      "path": "tests/map_tests.rs"
    },
    {
      "name": "nopanic",
      "path": "tests/nopanic.rs"
    }
  ],
  "bench": [
    {
      "name": "ahash",
      "path": "tests/bench.rs",
      "harness": false
    },
    {
      "name": "map",
      "path": "tests/map_tests.rs",
      "harness": false
    }
  ],
  "dependencies": {
    "cfg-if": {
      "version": "1.0"
    },
    "const-random": {
      "version": "0.1.17",
      "optional": true
    },
    "getrandom": {
      "version": "0.3.1",
      "optional": true
    },
    "portable-atomic": {
      "version": "1.0.0",
      "optional": true
    },
    "serde": {
      "version": "1.0.117",
      "optional": true
    },
    "zerocopy": {
      "version": "0.8.24",
      "features": [
        "simd"
      ],
      "default-features": false
    }
  },
  "dev-dependencies": {
    "criterion": {
      "version": "0.3.2",
      "features": [
        "html_reports"
      ]
    },
    "fnv": {
      "version": "1.0.5"
    },
    "fxhash": {
      "version": "0.2.1"
    },
    "hashbrown": {
      "version": "0.14.3"
    },
    "hex": {
      "version": "0.4.2"
    },
    "no-panic": {
      "version": "0.1.10"
    },
    "pcg-mwc": {
      "version": "0.2.1"
    },
    "rand": {
      "version": "0.8.5"
    },
    "seahash": {
      "version": "4.0"
    },
    "serde_json": {
      "version": "1.0.59"
    },
    "smallvec": {
      "version": "1.13.1"
    }
  },
  "build-dependencies": {
    "version_check": {
      "version": "0.9.4"
    }
  },
  "features": {
    "atomic-polyfill": [
      "dep:portable-atomic",
      "once_cell/critical-section"
    ],
    "compile-time-rng": [
      "const-random"
    ],
    "default": [
      "std",
      "runtime-rng"
    ],
    "nightly-arm-aes": [],
    "no-rng": [],
    "runtime-rng": [
      "getrandom"
    ],
    "std": []
  },
  "target": {
    "cfg(not(all(target_arch = \"arm\", target_os = \"none\")))": {
      "dependencies": {
        "once_cell": {
          "version": "1.18.0",
          "features": [
            "alloc"
          ],
          "default-features": false
        }
      }
    }
  }
}
