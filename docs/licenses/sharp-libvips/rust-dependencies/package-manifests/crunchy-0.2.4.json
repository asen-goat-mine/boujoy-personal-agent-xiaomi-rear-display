      "Eira Fransham <jackefransham@gmail.com>"
    ],
    "build": "build.rs",
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Crunchy unroller: deterministically unroll constant loops",
