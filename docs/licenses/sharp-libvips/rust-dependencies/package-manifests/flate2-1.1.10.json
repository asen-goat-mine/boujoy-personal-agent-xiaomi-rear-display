{
  "package": {
    "edition": "2018",
    "rust-version": "1.67.0",
    "name": "flate2",
    "version": "1.1.10",
    "authors": [
      "Alex Crichton <alex@alexcrichton.com>",
      "Josh Triplett <josh@joshtriplett.org>"
    ],
    "build": false,
    "exclude": [
      ".*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "DEFLATE compression and decompression exposed as Read/BufRead/Write streams.\nSupports miniz_oxide and multiple zlib implementations. Supports zlib, gzip,\nand raw deflate streams.\n",
    "homepage": "https://github.com/rust-lang/flate2-rs",
    "documentation": "https://docs.rs/flate2",
    "readme": "README.md",
    "keywords": [
      "gzip",
      "deflate",
      "zlib",
      "zlib-ng",
      "encoding"
    ],
    "categories": [
      "compression",
      "api-bindings"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/rust-lang/flate2-rs",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--cfg",
            "docsrs"
          ]
        }
      }
    }
  },
  "features": {
    "any_c_zlib": [
      "any_zlib"
    ],
    "any_impl": [],
    "any_zlib": [
      "any_impl"
    ],
    "cloudflare_zlib": [
      "zlib"
    ],
    "default": [
      "rust_backend",
      "runtime_detection"
    ],
    "miniz-sys": [
      "rust_backend"
    ],
    "miniz_oxide": [
      "any_impl",
      "dep:miniz_oxide",
      "dep:crc32fast"
    ],
    "runtime_detection": [
      "zlib-rs?/std",
      "crc32fast?/std"
    ],
    "rust_backend": [
      "miniz_oxide",
      "any_impl"
    ],
    "zlib": [
      "any_c_zlib",
      "libz-sys",
      "dep:crc32fast"
    ],
    "zlib-default": [
      "any_c_zlib",
      "libz-sys/default",
      "dep:crc32fast"
    ],
    "zlib-ng": [
      "any_c_zlib",
      "libz-ng-sys",
      "dep:crc32fast"
    ],
    "zlib-ng-compat": [
      "zlib",
      "libz-sys/zlib-ng",
      "dep:crc32fast"
    ],
    "zlib-rs": [
      "any_zlib",
      "dep:zlib-rs"
    ]
  },
  "lib": {
    "name": "flate2",
    "path": "src/lib.rs"
  },
  "example": [
    {
      "name": "compress_file",
      "path": "examples/compress_file.rs"
    },
    {
      "name": "decompress_file",
      "path": "examples/decompress_file.rs"
    },
    {
      "name": "deflatedecoder-bufread",
      "path": "examples/deflatedecoder-bufread.rs"
    },
    {
      "name": "deflatedecoder-read",
      "path": "examples/deflatedecoder-read.rs"
    },
    {
      "name": "deflatedecoder-write",
      "path": "examples/deflatedecoder-write.rs"
    },
    {
      "name": "deflateencoder-bufread",
      "path": "examples/deflateencoder-bufread.rs"
    },
    {
      "name": "deflateencoder-read",
      "path": "examples/deflateencoder-read.rs"
    },
    {
      "name": "deflateencoder-write",
      "path": "examples/deflateencoder-write.rs"
    },
    {
      "name": "gzbuilder",
      "path": "examples/gzbuilder.rs"
    },
    {
      "name": "gzdecoder-bufread",
      "path": "examples/gzdecoder-bufread.rs"
    },
    {
      "name": "gzdecoder-read",
      "path": "examples/gzdecoder-read.rs"
    },
    {
      "name": "gzdecoder-write",
      "path": "examples/gzdecoder-write.rs"
    },
    {
      "name": "gzencoder-bufread",
      "path": "examples/gzencoder-bufread.rs"
    },
    {
      "name": "gzencoder-read",
      "path": "examples/gzencoder-read.rs"
    },
    {
      "name": "gzencoder-write",
      "path": "examples/gzencoder-write.rs"
    },
    {
      "name": "gzmultidecoder-bufread",
      "path": "examples/gzmultidecoder-bufread.rs"
    },
    {
      "name": "gzmultidecoder-read",
      "path": "examples/gzmultidecoder-read.rs"
    },
    {
      "name": "zlibdecoder-bufread",
      "path": "examples/zlibdecoder-bufread.rs"
    },
    {
      "name": "zlibdecoder-read",
      "path": "examples/zlibdecoder-read.rs"
    },
    {
      "name": "zlibdecoder-write",
      "path": "examples/zlibdecoder-write.rs"
    },
    {
      "name": "zlibencoder-bufread",
      "path": "examples/zlibencoder-bufread.rs"
    },
    {
      "name": "zlibencoder-read",
      "path": "examples/zlibencoder-read.rs"
    },
    {
      "name": "zlibencoder-write",
      "path": "examples/zlibencoder-write.rs"
    }
  ],
  "test": [
    {
      "name": "capabilities",
      "path": "tests/capabilities.rs"
    },
    {
      "name": "early-flush",
      "path": "tests/early-flush.rs"
    },
    {
      "name": "empty-read",
      "path": "tests/empty-read.rs"
    },
    {
      "name": "gunzip",
      "path": "tests/gunzip.rs"
    },
    {
      "name": "zero-write",
      "path": "tests/zero-write.rs"
    }
  ],
  "dependencies": {
    "crc32fast": {
      "version": "1.2.0",
      "optional": true,
      "default-features": false
    },
    "document-features": {
      "version": "0.2",
      "optional": true
    },
    "libz-ng-sys": {
      "version": "1.1.16",
      "optional": true
    },
    "libz-sys": {
      "version": "1.1.20",
      "optional": true,
      "default-features": false
    },
    "miniz_oxide": {
      "version": "0.9.0",
      "features": [
        "simd"
      ],
      "optional": true
    },
    "zlib-rs": {
      "version": "0.6.0",
      "features": [
        "rust-allocator"
      ],
      "optional": true,
      "default-features": false
    }
  },
  "dev-dependencies": {
    "futures": {
      "version": "0.3",
      "default-features": false
    },
    "quickcheck": {
      "version": "1.0",
      "default-features": false
    },
    "rand": {
      "version": "0.9"
    }
  },
  "lints": {
    "rust": {
      "unexpected_cfgs": {
        "level": "warn",
        "priority": 0,
        "check-cfg": [
          "cfg(flate2_unstable_nightly_alloc_io)"
        ]
      }
    }
  }
}
