  "dependencies": {
    "derive_more-impl": {
      "version": "=2.1.1"
    }
  },
  "dev-dependencies": {
    "rustversion": {
      "version": "1.0"
    },
    "static_assertions": {
      "version": "1.1"
    },
    "trybuild": {
      "version": "1.0.56"
    }
  },
  "build-dependencies": {
    "rustc_version": {
      "version": "0.4",
      "optional": true
    }
  },
  "lints": {
    "rust": {
      "unexpected_cfgs": {
        "level": "warn",
        "priority": 0,
        "check-cfg": [
          "cfg(ci)",
          "cfg(nightly)"
        ]
      }
    }
  }
}
