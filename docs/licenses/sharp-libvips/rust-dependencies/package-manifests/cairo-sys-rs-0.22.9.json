{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "cairo-sys-rs",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": "build.rs",
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "FFI bindings to libcairo",
    "homepage": "https://gtk-rs.org/",
    "readme": false,
    "keywords": [
      "cairo",
      "ffi",
      "gtk-rs",
      "gnome"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "system-deps": {
        "cairo": {
          "name": "cairo",
          "version": "1.14",
          "v1_16": {
            "version": "1.16"
          },
          "v1_18": {
            "version": "1.18"
          }
        },
        "cairo-gobject": {
          "name": "cairo-gobject",
          "version": "1.14",
          "feature": "use_glib",
          "v1_16": {
            "version": "1.16"
          },
          "v1_18": {
            "version": "1.18"
          }
        }
      },
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--generate-link-to-definition"
          ]
        }
      }
    }
  },
  "features": {
    "freetype": [],
    "pdf": [],
    "png": [],
    "ps": [],
    "quartz-surface": [],
    "script": [],
    "svg": [],
    "use_glib": [
      "glib-sys"
    ],
    "v1_16": [],
    "v1_18": [
      "v1_16"
    ],
    "win32-surface": [
      "windows-sys"
    ],
    "xcb": [],
    "xlib": [
      "x11"
    ]
  },
  "lib": {
    "name": "cairo_sys",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "glib-sys": {
      "version": "0.22.0",
      "optional": true
    },
    "libc": {
      "version": "0.2"
    },
    "x11": {
      "version": "2.16",
      "optional": true,
      "package": "x11-dl"
    }
  },
  "build-dependencies": {
    "system-deps": {
      "version": "9"
    }
  },
  "target": {
    "cfg(windows)": {
      "dependencies": {
        "windows-sys": {
          "version": ">=0.52, <=0.61",
          "features": [
            "Win32_Graphics_Gdi"
          ],
          "optional": true
        }
      }
    }
  }
}
