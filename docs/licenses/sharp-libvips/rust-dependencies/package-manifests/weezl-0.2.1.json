{
  "package": {
    "edition": "2018",
    "rust-version": "1.88.0",
    "name": "weezl",
    "version": "0.2.1",
    "authors": [
      "The image-rs Developers"
    ],
    "build": false,
    "exclude": [
      "benches/*.lzw"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Fast LZW compression and decompression.",
    "documentation": "https://docs.rs/weezl",
    "readme": "README.md",
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/image-rs/weezl",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true
        }
      }
    }
  },
  "features": {
    "alloc": [],
    "async": [
      "futures",
      "std"
    ],
    "default": [
      "std"
    ],
    "std": [
      "alloc"
    ]
  },
  "lib": {
    "name": "weezl",
    "path": "src/lib.rs",
    "bench": false
  },
  "bin": [
    {
      "name": "lzw",
      "path": "bin/lzw.rs",
      "bench": false,
      "required-features": [
        "std"
      ]
    }
  ],
  "example": [
    {
      "name": "lzw-compress",
      "path": "examples/lzw-compress.rs",
      "required-features": [
        "std"
      ]
    },
    {
      "name": "lzw-decompress",
      "path": "examples/lzw-decompress.rs",
      "required-features": [
        "std"
      ]
    }
  ],
  "test": [
    {
      "name": "async",
      "path": "tests/async.rs",
      "required-features": [
        "async",
        "std"
      ]
    },
    {
      "name": "end_of_buffer",
      "path": "tests/end_of_buffer.rs",
      "required-features": [
        "alloc"
      ]
    },
    {
      "name": "fuzz_panic_regression",
      "path": "tests/fuzz_panic_regression.rs",
      "required-features": [
        "alloc"
      ]
    },
    {
      "name": "implicit_reset",
      "path": "tests/implicit_reset.rs",
      "required-features": [
        "std"
      ]
    },
    {
      "name": "lowbit_roundtrip",
      "path": "tests/lowbit_roundtrip.rs"
    },
    {
      "name": "progress_into_buffer",
      "path": "tests/progress_into_buffer.rs",
      "required-features": [
        "alloc"
      ]
    },
    {
      "name": "regression_gif",
      "path": "tests/regression_gif.rs",
      "required-features": [
        "alloc"
      ]
    },
    {
      "name": "roundtrip",
      "path": "tests/roundtrip.rs",
      "required-features": [
        "std"
      ]
    },
    {
      "name": "roundtrip_vec",
      "path": "tests/roundtrip_vec.rs",
      "required-features": [
        "alloc"
      ]
    },
    {
      "name": "yield_on_full_regression",
      "path": "tests/yield_on_full_regression.rs"
    }
  ],
  "bench": [
    {
      "name": "generators",
      "path": "benches/generators.rs"
    },
    {
      "name": "lowbit",
      "path": "benches/lowbit.rs",
      "harness": false,
      "required-features": [
        "std"
      ]
    },
    {
      "name": "msb8",
      "path": "benches/msb8.rs",
      "harness": false,
      "required-features": [
        "std"
      ]
    }
  ],
  "dependencies": {
    "futures": {
      "version": "0.3.12",
      "features": [
        "std"
      ],
      "optional": true,
      "default-features": false
    }
  },
  "dev-dependencies": {
    "criterion": {
      "version": "0.3.1"
    },
    "tokio": {
      "version": "1",
      "features": [
        "macros",
        "io-util",
        "net",
        "rt",
        "rt-multi-thread"
      ],
      "default-features": false
    },
    "tokio-util": {
      "version": "0.6.2",
      "features": [
        "compat"
      ],
      "default-features": false
    },
    "zenbench": {
      "version": "0.1.3"
    }
  }
}
