  "dependencies": {
    "aes": {
      "version": "0.9"
    },
    "bitflags": {
      "version": "2.13"
    },
    "cbc": {
      "version": "0.2"
    },
    "chrono": {
      "version": "0.4",
      "features": [
        "std",
        "clock"
      ],
      "optional": true,
      "default-features": false
    },
    "ecb": {
      "version": "0.2"
    },
    "encoding_rs": {
      "version": "0.8"
    },
    "flate2": {
      "version": "1.1"
    },
    "getrandom": {
      "version": "0.4"
    },
    "image": {
      "version": "0.25",
      "optional": true
    },
    "indexmap": {
      "version": "2.14"
    },
    "itoa": {
      "version": "1.0"
    },
    "jiff": {
      "version": "0.2",
      "optional": true
    },
    "log": {
      "version": "0.4"
    },
    "md-5": {
      "version": "0.11"
    },
    "nom": {
      "version": "8.0"
    },
    "rand": {
      "version": "0.10"
    },
    "rangemap": {
      "version": "1.7"
    },
    "rayon": {
      "version": "1.12",
      "optional": true
    },
    "serde": {
      "version": "1.0",
      "features": [
        "derive"
      ],
      "optional": true
    },
    "sha2": {
      "version": "0.11"
    },
    "stringprep": {
      "version": "0.1.5"
    },
    "thiserror": {
      "version": "2.0"
    },
    "time": {
      "version": "0.3",
      "features": [
        "formatting",
        "parsing"
      ],
      "optional": true
    },
    "tokio": {
      "version": "1",
      "features": [
        "fs",
        "io-util"
      ],
      "optional": true
    },
    "ttf-parser": {
      "version": "0.25.1",
      "optional": true
    },
    "weezl": {
      "version": "0.2"
    }
  },
  "dev-dependencies": {
    "clap": {
      "version": "4.6",
      "features": [
        "derive"
      ]
    },
    "env_logger": {
      "version": "0.11"
    },
    "flate2": {
      "version": "1.1"
    },
    "serde_json": {
      "version": "1.0"
    },
    "shellexpand": {
      "version": "3.1"
    },
    "tempfile": {
      "version": "3.27"
    },
    "ttf-parser": {
      "version": "0.25.1"
    },
    "wasm-bindgen-test": {
      "version": "0.3"
    }
  },
  "target": {
    "cfg(not(target_family=\"wasm\"))": {
      "dev-dependencies": {
        "criterion": {
          "version": "0.8"
        }
      }
    }
  }
