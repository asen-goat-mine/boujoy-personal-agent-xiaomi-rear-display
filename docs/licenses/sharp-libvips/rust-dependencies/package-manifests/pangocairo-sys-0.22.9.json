{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "pangocairo-sys",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": "build.rs",
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "FFI bindings to PangoCairo",
    "homepage": "https://gtk-rs.org/",
    "readme": false,
    "keywords": [
      "gtk",
      "ffi",
      "gtk-rs",
      "gnome"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "system-deps": {
        "pangocairo": {
          "name": "pangocairo",
          "version": "1.40",
          "v1_58": {
            "version": "1.58"
          }
        }
      },
      "docs": {
        "rs": {
          "rustdoc-args": [
            "--generate-link-to-definition"
          ],
          "all-features": true
        }
      }
    }
  },
  "features": {
    "v1_58": []
  },
  "lib": {
    "name": "pango_cairo_sys",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "cairo-sys-rs": {
      "version": "0.22.0"
    },
    "glib-sys": {
      "version": "0.22.0"
    },
    "libc": {
      "version": "0.2"
    },
    "pango-sys": {
      "version": "0.22.0"
    }
  },
  "dev-dependencies": {
    "shell-words": {
      "version": "1.0.0"
    },
    "tempfile": {
      "version": "3"
    }
  },
  "build-dependencies": {
    "system-deps": {
      "version": "9"
    }
  }
}
