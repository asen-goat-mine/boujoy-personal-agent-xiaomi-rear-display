{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "gio-sys",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": "build.rs",
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "FFI bindings to libgio-2.0",
    "homepage": "https://gtk-rs.org/",
    "readme": false,
    "keywords": [
      "gio",
      "ffi",
      "gtk-rs",
      "gnome"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "system-deps": {
        "gio_2_0": {
          "name": "gio-2.0",
          "version": "2.56",
          "v2_58": {
            "version": "2.58"
          },
          "v2_60": {
            "version": "2.60"
          },
          "v2_62": {
            "version": "2.62"
          },
          "v2_64": {
            "version": "2.64"
          },
          "v2_66": {
            "version": "2.66"
          },
          "v2_68": {
            "version": "2.68"
          },
          "v2_70": {
            "version": "2.70"
          },
          "v2_72": {
            "version": "2.72"
          },
          "v2_74": {
            "version": "2.74"
          },
          "v2_76": {
            "version": "2.76"
          },
          "v2_78": {
            "version": "2.78"
          },
          "v2_80": {
            "version": "2.80"
          },
          "v2_82": {
            "version": "2.82"
          },
          "v2_84": {
            "version": "2.84"
          },
          "v2_86": {
            "version": "2.86"
          },
          "v2_88": {
            "version": "2.88"
          },
          "v2_90": {
            "version": "2.89"
          }
        }
      },
      "docs": {
        "rs": {
          "rustdoc-args": [
            "--generate-link-to-definition"
          ],
          "all-features": true
        }
      }
    }
  },
  "features": {
    "v2_58": [],
    "v2_60": [
      "v2_58"
    ],
    "v2_62": [
      "v2_60"
    ],
    "v2_64": [
      "v2_62"
    ],
    "v2_66": [
      "v2_64"
    ],
    "v2_68": [
      "v2_66"
    ],
    "v2_70": [
      "v2_68"
    ],
    "v2_72": [
      "v2_70"
    ],
    "v2_74": [
      "v2_72"
    ],
    "v2_76": [
      "v2_74"
    ],
    "v2_78": [
      "v2_76"
    ],
    "v2_80": [
      "v2_78"
    ],
    "v2_82": [
      "v2_80"
    ],
    "v2_84": [
      "v2_82"
    ],
    "v2_86": [
      "v2_84"
    ],
    "v2_88": [
      "v2_86"
    ],
    "v2_90": [
      "v2_88"
    ]
  },
  "lib": {
    "name": "gio_sys",
    "path": "src/lib.rs"
  },
  "test": [
    {
      "name": "abi",
      "path": "tests/abi.rs"
    }
  ],
  "dependencies": {
    "glib-sys": {
      "version": "0.22.0"
    },
    "gobject-sys": {
      "version": "0.22.0"
    },
    "libc": {
      "version": "0.2"
    }
  },
  "dev-dependencies": {
    "shell-words": {
      "version": "1.0.0"
    },
    "tempfile": {
      "version": "3"
    }
  },
  "build-dependencies": {
    "system-deps": {
      "version": "9"
    }
  },
  "target": {
    "cfg(windows)": {
      "dependencies": {
        "windows-sys": {
          "version": ">=0.52, <=0.61",
          "features": [
            "Win32_Networking_WinSock"
          ]
        }
      }
    }
  }
}
