{
  "package": {
    "edition": "2021",
    "rust-version": "1.61",
    "name": "ppv-lite86",
    "version": "0.2.21",
    "authors": [
      "The CryptoCorrosion Contributors"
    ],
    "build": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Cross-platform cryptography-oriented low-level SIMD library.",
    "readme": false,
    "keywords": [
      "crypto",
      "simd",
      "x86"
    ],
    "categories": [
      "cryptography",
      "no-std"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/cryptocorrosion/cryptocorrosion"
  },
  "lib": {
    "name": "ppv_lite86",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "zerocopy": {
      "version": "0.8.23",
      "features": [
        "simd"
      ]
    }
  },
  "features": {
    "default": [
      "std"
    ],
    "no_simd": [],
    "simd": [],
    "std": []
  },
  "badges": {
    "travis-ci": {
      "repository": "cryptocorrosion/cryptocorrosion"
    }
  }
}
