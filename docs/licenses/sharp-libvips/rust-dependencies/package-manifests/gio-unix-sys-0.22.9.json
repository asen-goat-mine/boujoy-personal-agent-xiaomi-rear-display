{
  "package": {
    "edition": "2024",
    "rust-version": "1.92",
    "name": "gio-unix-sys",
    "version": "0.22.9",
    "authors": [
      "The gtk-rs Project Developers"
    ],
    "build": "build.rs",
    "exclude": [
      "gir-files/*"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "FFI bindings to libgio-2.0 Unix APIs",
    "homepage": "https://gtk-rs.org/",
    "readme": false,
    "keywords": [
      "gio",
      "ffi",
      "gtk-rs",
      "gnome"
    ],
    "license": "MIT",
    "repository": "https://github.com/gtk-rs/gtk-rs-core",
    "metadata": {
      "system-deps": {
        "glib_2_0": {
          "name": "glib-2.0",
          "version": "2.56"
        },
        "gio_unix_2_0": {
          "name": "gio-unix-2.0",
          "version": "2.56",
          "v2_58": {
            "version": "2.58"
          },
          "v2_60": {
            "version": "2.60"
          },
          "v2_66": {
            "version": "2.66"
          },
          "v2_82": {
            "version": "2.82"
          },
          "v2_84": {
            "version": "2.84"
          }
        }
      },
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--generate-link-to-definition"
          ]
        }
      }
    }
  },
  "features": {
    "v2_58": [],
    "v2_60": [
      "v2_58"
    ],
    "v2_66": [
      "v2_60"
    ],
    "v2_82": [
      "v2_66"
    ],
    "v2_84": [
      "v2_82"
    ]
  },
  "lib": {
    "name": "gio_unix_sys",
    "path": "src/lib.rs"
  },
  "test": [
    {
      "name": "abi",
      "path": "tests/abi.rs"
    }
  ],
  "dependencies": {
    "gio-sys": {
      "version": "0.22.0"
    },
    "glib-sys": {
      "version": "0.22.0"
    },
    "gobject-sys": {
      "version": "0.22.0"
    },
    "libc": {
      "version": "0.2"
    }
  },
  "dev-dependencies": {
    "shell-words": {
      "version": "1.0.0"
    },
    "tempfile": {
      "version": "3"
    }
  },
  "build-dependencies": {
    "system-deps": {
      "version": "9"
    }
  }
}
