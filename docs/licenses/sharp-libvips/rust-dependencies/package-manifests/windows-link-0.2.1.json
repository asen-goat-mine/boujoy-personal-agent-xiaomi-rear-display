{
  "package": {
    "edition": "2021",
    "rust-version": "1.71",
    "name": "windows-link",
    "version": "0.2.1",
    "build": false,
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Linking for Windows",
    "readme": "readme.md",
    "categories": [
      "os::windows-apis"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/microsoft/windows-rs"
  },
  "lib": {
    "name": "windows_link",
    "path": "src/lib.rs"
  },
  "lints": {
    "rust": {
      "missing_unsafe_on_extern": "warn",
      "unexpected_cfgs": {
        "level": "warn",
        "priority": 0,
        "check-cfg": [
          "cfg(windows_raw_dylib, windows_slim_errors)"
        ]
      }
    }
  }
}
