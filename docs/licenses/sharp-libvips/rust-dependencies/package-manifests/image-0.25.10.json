{
  "package": {
    "edition": "2021",
    "rust-version": "1.88.0",
    "name": "image",
    "version": "0.25.10",
    "authors": [
      "The image-rs Developers"
    ],
    "build": false,
    "exclude": [
      "src/png/testdata/*",
      "examples/*",
      "tests/*"
    ],
    "include": [
      "/LICENSE-APACHE",
      "/LICENSE-MIT",
      "/README.md",
      "/CHANGES.md",
      "/src/",
      "/benches/"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Imaging library. Provides basic image processing and encoders/decoders for common image formats.",
    "homepage": "https://github.com/image-rs/image",
    "documentation": "https://docs.rs/image",
    "readme": "README.md",
    "categories": [
      "multimedia::images",
      "multimedia::encoding",
      "encoding"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/image-rs/image",
    "resolver": "2",
    "metadata": {
      "cargo-semver-checks": {
        "lints": {
          "enum_discriminants_undefined_non_unit_variant": {
            "level": "warn"
          }
        }
      },
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--cfg",
            "docsrs"
          ]
        }
      }
    }
  },
  "features": {
    "avif": [
      "dep:ravif",
      "dep:rgb"
    ],
    "avif-native": [
      "dep:mp4parse",
      "dep:dav1d"
    ],
    "benchmarks": [],
    "bmp": [],
    "color_quant": [
      "dep:color_quant"
    ],
    "dds": [],
    "default": [
      "rayon",
      "default-formats"
    ],
    "default-formats": [
      "avif",
      "bmp",
      "dds",
      "exr",
      "ff",
      "gif",
      "hdr",
      "ico",
      "jpeg",
      "png",
      "pnm",
      "qoi",
      "tga",
      "tiff",
      "webp"
    ],
    "exr": [
      "dep:exr"
    ],
    "ff": [],
    "gif": [
      "dep:gif",
      "dep:color_quant"
    ],
    "hdr": [],
    "ico": [
      "bmp",
      "png"
    ],
    "jpeg": [
      "dep:zune-core",
      "dep:zune-jpeg"
    ],
    "nasm": [
      "ravif?/asm"
    ],
    "png": [
      "dep:png"
    ],
    "pnm": [],
    "qoi": [
      "dep:qoi"
    ],
    "rayon": [
      "dep:rayon",
      "ravif?/threading",
      "exr?/rayon"
    ],
    "serde": [
      "dep:serde"
    ],
    "tga": [],
    "tiff": [
      "dep:tiff"
    ],
    "webp": [
      "dep:image-webp"
    ]
  },
  "lib": {
    "name": "image",
    "path": "src/lib.rs"
  },
  "bench": [
    {
      "name": "blur",
      "path": "benches/blur.rs",
      "harness": false
    },
    {
      "name": "convert",
      "path": "benches/convert.rs",
      "harness": false
    },
    {
      "name": "copy_from",
      "path": "benches/copy_from.rs",
      "harness": false
    },
    {
      "name": "decode",
      "path": "benches/decode.rs",
      "harness": false
    },
    {
      "name": "encode",
      "path": "benches/encode.rs",
      "harness": false
    },
    {
      "name": "fast_blur",
      "path": "benches/fast_blur.rs",
      "harness": false
    }
  ],
  "dependencies": {
    "bytemuck": {
      "version": "1.8.0",
      "features": [
        "extern_crate_alloc"
      ]
    },
    "byteorder-lite": {
      "version": "0.1.0"
    },
    "color_quant": {
      "version": "1.1",
      "optional": true
    },
    "dav1d": {
      "version": "0.11.0",
      "optional": true
    },
    "exr": {
      "version": "1.74.0",
      "optional": true,
      "default-features": false
    },
    "gif": {
      "version": "0.14.0",
      "optional": true
    },
    "image-webp": {
      "version": "0.2.0",
      "optional": true
    },
    "moxcms": {
      "version": "0.8.0"
    },
    "mp4parse": {
      "version": "0.17.0",
      "optional": true
    },
    "num-traits": {
      "version": "0.2.0"
    },
    "png": {
      "version": "0.18.0",
      "optional": true
    },
    "qoi": {
      "version": "0.4",
      "optional": true
    },
    "ravif": {
      "version": "0.13",
      "optional": true,
      "default-features": false
    },
    "rayon": {
      "version": "1.7.0",
      "optional": true
    },
    "rgb": {
      "version": "0.8.48",
      "optional": true,
      "default-features": false
    },
    "serde": {
      "version": "1.0.214",
      "features": [
        "derive"
      ],
      "optional": true
    },
    "tiff": {
      "version": "0.11.2",
      "optional": true
    },
    "zune-core": {
      "version": "0.5.0",
      "optional": true,
      "default-features": false
    },
    "zune-jpeg": {
      "version": "0.5.5",
      "optional": true
    }
  },
  "dev-dependencies": {
    "crc32fast": {
      "version": "1.2.0"
    },
    "criterion": {
      "version": "0.5.0"
    },
    "glob": {
      "version": "0.3"
    },
    "num-complex": {
      "version": "0.4"
    },
    "quickcheck": {
      "version": "1"
    }
  }
}
