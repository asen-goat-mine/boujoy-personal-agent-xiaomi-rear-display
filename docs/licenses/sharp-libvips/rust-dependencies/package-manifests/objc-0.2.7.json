{
  "package": {
    "name": "objc",
    "version": "0.2.7",
    "authors": [
      "Steven Sheldon"
    ],
    "exclude": [
      ".gitignore",
      ".travis.yml",
      "doc.sh",
      "travis_install.sh",
      "travis_test.sh",
      "tests-ios/**"
    ],
    "description": "Objective-C Runtime bindings and wrapper for Rust.",
    "documentation": "http://ssheldon.github.io/rust-objc/objc/",
    "readme": "README.md",
    "keywords": [
      "objective-c",
      "osx",
      "ios",
      "cocoa",
      "uikit"
    ],
    "license": "MIT",
    "repository": "http://github.com/SSheldon/rust-objc"
  },
  "dependencies": {
    "malloc_buf": {
      "version": "0.0"
    },
    "objc_exception": {
      "version": "0.1",
      "optional": true
    }
  },
  "features": {
    "exception": [
      "objc_exception"
    ],
    "verify_message": []
  }
}
