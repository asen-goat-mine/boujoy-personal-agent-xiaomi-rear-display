{
  "package": {
    "edition": "2021",
    "rust-version": "1.56",
    "name": "dlib",
    "version": "0.5.3",
    "authors": [
      "Elinor Berger <elinor@safaradeg.net>"
    ],
    "build": false,
    "exclude": [
      "/dlib-test",
      "README.tpl"
    ],
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Helper macros for handling manually loading optional system libraries.",
    "readme": "README.md",
    "keywords": [
      "dylib",
      "dlopen"
    ],
    "categories": [
      "api-bindings"
    ],
    "license": "MIT",
    "repository": "https://github.com/elinorbgr/dlib"
  },
  "lib": {
    "name": "dlib",
    "path": "src/lib.rs"
  },
  "dependencies": {
    "libloading": {
      "version": ">=0.7, <0.9"
    }
  }
}
