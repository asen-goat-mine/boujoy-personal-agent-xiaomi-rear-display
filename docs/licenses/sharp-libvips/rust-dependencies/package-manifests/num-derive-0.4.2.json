{
  "package": {
    "edition": "2021",
    "rust-version": "1.56.0",
    "name": "num-derive",
    "version": "0.4.2",
    "authors": [
      "The Rust Project Developers"
    ],
    "exclude": [
      "/ci/*",
      "/.github/*"
    ],
    "description": "Numeric syntax extensions",
    "homepage": "https://github.com/rust-num/num-derive",
    "documentation": "https://docs.rs/num-derive",
    "readme": "README.md",
    "keywords": [
      "mathematics",
      "numerics"
    ],
    "categories": [
      "science"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/rust-num/num-derive"
  },
  "lib": {
    "name": "num_derive",
    "test": false,
    "proc-macro": true
  },
  "test": [
    {
      "name": "newtype-2015",
      "edition": "2015"
    },
    {
      "name": "newtype-2018",
      "edition": "2018"
    },
    {
      "name": "trivial-2015",
      "edition": "2015"
    },
    {
      "name": "trivial-2018",
      "edition": "2018"
    }
  ],
  "dependencies": {
    "proc-macro2": {
      "version": "1"
    },
    "quote": {
      "version": "1"
    },
    "syn": {
      "version": "2.0.5"
    }
  },
  "dev-dependencies": {
    "num": {
      "version": "0.4"
    },
    "num-traits": {
      "version": "0.2"
    }
  }
}
