{
  "package": {
    "edition": "2018",
    "rust-version": "1.51",
    "name": "data-url",
    "version": "0.3.2",
    "authors": [
      "Simon Sapin <simon.sapin@exyr.org>"
    ],
    "build": false,
    "autolib": false,
    "autobins": false,
    "autoexamples": false,
    "autotests": false,
    "autobenches": false,
    "description": "Processing of data: URL according to WHATWG’s Fetch Standard",
    "readme": "README.md",
    "categories": [
      "no-std"
    ],
    "license": "MIT OR Apache-2.0",
    "repository": "https://github.com/servo/rust-url",
    "metadata": {
      "docs": {
        "rs": {
          "rustdoc-args": [
            "--generate-link-to-definition"
          ]
        }
      }
    }
  },
  "features": {
    "alloc": [],
    "default": [
      "std"
    ],
    "std": [
      "alloc"
    ]
  },
  "lib": {
    "name": "data_url",
    "path": "src/lib.rs",
    "test": true
  },
  "test": [
    {
      "name": "wpt",
      "path": "tests/wpt.rs",
      "harness": false
    }
  ],
  "dev-dependencies": {
    "serde": {
      "version": "1.0",
      "features": [
        "alloc",
        "derive"
      ],
      "default-features": false
    },
    "serde_json": {
      "version": "1.0"
    },
    "tester": {
      "version": "0.9"
    },
    "unicode-width": {
      "version": "=0.1.12"
    }
  }
}
